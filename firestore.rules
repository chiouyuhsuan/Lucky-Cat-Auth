rules_version = '2';

// LuckyCat Firestore 安全規則
// 原則：
//   1. 所有人都能讀（排行榜、貓咪牆是公開的）
//   2. 只有登入者能新增資料，而且只能用自己的 uid
//   3. 中獎相關欄位（prizeLevel / prizeAmount / checkedAt / totalWins / totalPrize）
//      前端一律不能改，只有 GitHub Actions 用 Admin SDK 寫入（Admin SDK 不受規則限制）
//   4. 前端不能刪除任何資料
// 第 2 段改寫選號流程時，會連同新欄位一起更新這份規則。

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwnerOfNew() {
      return signedIn() && request.resource.data.uid == request.auth.uid;
    }

    function isOwner() {
      return signedIn() && resource.data.uid == request.auth.uid;
    }

    // 照片：null，或 900KB 以內的 data:image 字串（Firestore 單筆上限 1MB）
    function validPhoto(p) {
      return p == null || (p is string && p.size() < 900000 && p.matches('^data:image/(png|jpe?g|webp);base64,.*'));
    }

    function validName(n) {
      return n is string && n.size() >= 1 && n.size() <= 20;
    }

    function validText(t) {
      return t is string && t.size() <= 100;
    }

    // ── 貓咪主檔 ─────────────────────────────────────────
    match /cats/{catId} {
      allow read: if true;

      allow create: if isOwnerOfNew()
        && request.resource.data.keys().hasOnly([
             'uid', 'catName', 'photoThumb', 'country', 'countryCode', 'city',
             'totalDraws', 'totalWins', 'totalPrize', 'createdAt', 'lastDrawAt'])
        && validName(request.resource.data.catName)
        && validPhoto(request.resource.data.photoThumb)
        && validText(request.resource.data.country)
        && validText(request.resource.data.countryCode)
        && validText(request.resource.data.city)
        && request.resource.data.totalDraws == 1
        && request.resource.data.totalWins == 0
        && request.resource.data.totalPrize == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastDrawAt == request.time;

      // 擁有者只能換照片、抽號次數 +1、更新最後抽號時間
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['photoThumb', 'totalDraws', 'lastDrawAt'])
        && validPhoto(request.resource.data.photoThumb)
        && request.resource.data.totalDraws == resource.data.totalDraws + 1
        && request.resource.data.lastDrawAt == request.time;

      allow delete: if false;
    }

    // ── 選號紀錄 ─────────────────────────────────────────
    match /draws/{drawId} {
      allow read: if true;

      allow create: if isOwnerOfNew()
        && request.resource.data.keys().hasOnly([
             'uid', 'catId', 'catName', 'lotType', 'lotName', 'lotFlag',
             'numbers', 'special', 'country', 'countryCode', 'city', 'date',
             'photoThumb', 'createdAt', 'prizeLevel', 'prizeAmount'])
        && validName(request.resource.data.catName)
        && validPhoto(request.resource.data.photoThumb)
        && request.resource.data.lotType in ['tw', 'us', 'jp']
        && request.resource.data.numbers is list
        && request.resource.data.numbers.size() <= 6
        && request.resource.data.special is list
        && request.resource.data.special.size() <= 1
        && validText(request.resource.data.lotName)
        && validText(request.resource.data.lotFlag)
        && validText(request.resource.data.country)
        && validText(request.resource.data.countryCode)
        && validText(request.resource.data.city)
        && validText(request.resource.data.date)
        && (request.resource.data.catId == null || request.resource.data.catId is string)
        && request.resource.data.prizeLevel == 0
        && request.resource.data.prizeAmount == 0
        && request.resource.data.createdAt == request.time;

      // 對獎結果只能由後端寫入
      allow update, delete: if false;
    }

    // ── 全站統計 ─────────────────────────────────────────
    // 暫時保留前端 +1 的寫法；第 2 段改成更可靠的計數方式
    match /stats/global {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['totalDraws'])
        && request.resource.data.totalDraws == 1;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalDraws'])
        && request.resource.data.totalDraws == resource.data.totalDraws + 1;
      allow delete: if false;
    }

    // ── 開獎結果（後端寫入）─────────────────────────────
    match /draws_results/{resultId} {
      allow read: if true;
      allow write: if false;
    }

    // 其他集合一律拒絕
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
